# ---------------------------------------------------------------------------
# G1 Mode — environment template
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time and are
# therefore NOT secrets. Never put private API keys here — only publishable
# SDK keys (RevenueCat public SDK keys, PostHog project keys).
# ---------------------------------------------------------------------------

# --- RevenueCat (public SDK keys, one per platform) ---
# Dashboard → Project → API keys
EXPO_PUBLIC_RC_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- PostHog (project API key, publishable) ---
EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Feature flags (flip without a code change during pilot) ---
# Set to "false" to build without RevenueCat/PostHog native init (useful for
# a first dev build before store products exist).
EXPO_PUBLIC_ENABLE_MONETIZATION=false
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# --- EAS project (filled in by `eas init`) ---
# EXPO_PUBLIC_EAS_PROJECT_ID=